
def main():
    
    
    
    # grp names
    
    assetGrp =  process.get_option( 'asset Grp' , group = 'Groups' )
    
    # create model top grp
    
    modelGrp = cmds.group( em = 1, n = process.get_option( 'model Grp' , group = 'Groups' ) , p = assetGrp )
    
    # import model and parent to top grp
    
    cmds.parent( process.import_data( 'model' ) , 'Model_Grp' )
    
    # parent top to asset grp
    
    cmds.parent( modelGrp , assetGrp )
    
    return