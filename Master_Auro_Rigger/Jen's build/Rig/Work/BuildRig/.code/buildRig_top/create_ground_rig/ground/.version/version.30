    firstCnt = rig.controls[0]
    subCnt = rig.controls[-1]
    drivers = cmds.ls(firstCnt, l=1)[0].split('|')[-3]
    cmds.parent( firstCnt, controlsGrp )
    cmds.delete(drivers)'''
    
    
    
