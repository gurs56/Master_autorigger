from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util

def main():
    
    # vars
    
    rigGrp = process.get_option( 'rig Grp' , group = 'Groups' )
    controlsGrp = process.get_option( 'controls Grp' , group = 'Groups' )    
    joints = process.get_option('root', group = 'Rig Bone Groups')
    modelGrp = process.get_option( 'model Grp' , group = 'Groups' )
    sizex, sizey, sizez =  cmds.getAttr('%s.boundingBoxMax'%modelGrp)[0]
        
    # ground control
    
    rig = rigs.GroundRig('Ground')
    rig.set_joints(joints)
    rig.set_attach_joints(False)
    #rig.set_control_to_pivot(True)
    
    
    #rig.set_create_sub_control(True)
    #rig.set_sub_visibility(False)
    rig.set_control_shape('outwardCirclePointer')
    rig.set_control_size(3)
    rig.set_control_color(22)
    rig.set_scalable(True)
    rig.set
    #rig.set_sub_control_color(17)
    #rig.set_attach_type('hi')
    #rig.set_no_last_number(True)
    #rig.set_number_in_control_name(False)
    
    
    #rig.set_scalable(True, keep_negative_scale_on_joint=False)
    
    rig.delete_setup()
    rig.create()
    
    rig.set_control_parent( controlsGrp )
