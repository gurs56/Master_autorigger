from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util
from vtool.maya_lib import attr


def main():
    
    # vars
    sides = ['l', 'r']
    rigGrp = process.get_option( 'rig Grp' , group = 'Groups' )
    controlsGrp = process.get_option( 'controls Grp' , group = 'Groups' )    
    setupGrp = process.get_option( 'setup Grp' , group = 'Groups' )    
    subGround2 = process.get_option('sub ground 2', group = 'Groups')
    subCog = 'CNT_SUB_COG_C'
    hips = 'CNT_SUB_HIPS_C'
    
    setup_grp = process.get_option( 'setup Grp' , group = 'Groups' )   
    
    for side in sides:
        
        joints = [
                i for i in process.get_option( 'feet' , 
                group = 'Rig Bone Groups' ) 
                if i.find('%s_%s'% ( i[:-2] , side )) != -1
                and if i.find('ball') != -1
                ]
        if side.find('l') != -1: # test 1
            # ik foot roll setup
            
            foot_roll = rigs.FootRollRig('FootRoll',side=side)
            foot_roll.set_joints(joints)

            foot_roll.create()
            foot_roll.set_control_parent('CNT_IK_LEG_BTM_1_%s' % side.upper() )
            foot_roll.set_setup_parent(setup_grp)
        
        elif side.find('r') != -1: # test 2
            # ik foot roll setup
            
            foot_roll = rigs.FootRig('FootRoll',side=side)
            foot_roll.set_joints(joints)
            
            foot_roll.create()
            foot_roll.set_control_parent('CNT_IK_LEG_BTM_1_%s' % side.upper() )
            foot_roll.set_setup_parent(setup_grp)
        
        
    
    
    
    
    
    return