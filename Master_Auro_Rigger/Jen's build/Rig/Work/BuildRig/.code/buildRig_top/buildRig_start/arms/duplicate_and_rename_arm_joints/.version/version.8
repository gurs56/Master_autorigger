
def main():
    
    
    # vars
    
    side = 'l'
    joints = [i for i in process.get_option('arms', group = 'Rig Bone Groups') if i.find('JNT_clavicle_%s'%side) != -1][0]
    
    dup = cmds.duplicate(joints, n = joints.replace('JNT_', 'IK_'), rr=1)
    
    
    for j in cmds.listRelatives(dup, ad=1, f=1):
        j_sn  = j.split('|')[-1]
        if j_sn.find('JNT_') != -1:
            j_ikname = j_sn.replace('JNT_', 'IK_')
            cmds.rename( j, j_ikname )
    
    cmds.delete(cmds.listRelatives('IK_hand_%s'%side))
    
    return