
def main():
    
    sides = ['l', 'r']
    
    for side in sides:
        followGrp = cmds.group(em=1, n= 'handFollow_Grp_%s' % side.upper(), p= 'CNT_CLAVICLE_1_%s' % side.upper())
        cmds.parentConstraint('JNT_hand_%s' % side, followGrp, mo=0)
        
        
        # parent hand gear to it
        handGearXform = 'xform_CNT_GEAR_HAND_1_%s' % side.upper()
        cmds.parent( handGearXform , followGrp , r=1 )
        pc = cmds.parentConstraint( followGrp , handGearXform, mo=0)
        cmds.delete(pc)
        
        
        
    return