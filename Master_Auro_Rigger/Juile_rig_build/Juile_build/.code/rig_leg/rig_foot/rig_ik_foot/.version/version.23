from vtool.maya_lib import space
import maya.cmds as cmds

def create_ik_foot(side):

    # STEP 1: Create and match locator to the ankle joint (named 'foot' in your case)
    locator_name = 'locator_foot_%s' % side
    if not cmds.objExists(locator_name):
        locator = cmds.spaceLocator(n=locator_name)[0]
        space.MatchSpace('JNT_foot_%s' % side, locator).translation_rotation()

        # STEP 2: Create the setup group if needed
        setup_group_name = 'setup_foot_1_%s' % side
        if not cmds.objExists(setup_group_name):
            cmds.group(em=True, name=setup_group_name, parent='RigParts')

        # STEP 3: Parent the locator into the setup group
        cmds.parent(locator, setup_group_name)

    # STEP 4: Continue with FootRig setup
    joints = [locator_name,
              'JNT_ball_%s' % side,
              'JNT_toe_%s' % side]

    rig = rigs.FootRig('foot', side)
    rig.set_joints(joints)
    rig.set_pivot_locators(
        'Heel_%s_Loc' % side.upper(),
        'BallYawIn_%s_Loc' % side.upper(),
        'BallYawOut_%s_Loc' % side.upper()
    )
    rig.set_ik_leg([
        'xform_offset_CNT_SUB_LEG_BTM_1_%s' % side.upper(),
        'xform_ikHandle_leg_1_%s' % side.upper()
    ])
    rig.set_buffer(True)
    rig.set_control_shape('square')
    rig.set_control_size(control_size)
    rig.create()

    rig.set_control_parent('CNT_SUB_LEG_BTM_1_%s' % side.upper())
    rig.set_setup_parent(setup_group)
