from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util
from vtool.maya_lib import space
from vtool.maya_lib import geo

def main():
    # Retrieve rig options
    rigparts = process.get_option("RigParts", group="Groups")
    size = 1.5  # Replace with your actual size variable if it's defined elsewhere

    # Loop through both sides
    for side in ['L', 'R']:
        # Retrieve the joints for the current side
        joints = process.get_option("Leg_%s" % side, group="Joint")

        # Initialize the IK Appendage Rig
        rig = rigs.IkAppendageRig('ik_leg', side)
        rig.set_joints(joints)

        # Configure rig settings
        rig.set_control_size(size * 15)
        rig.set_control_offset_axis("z")
        rig.set_buffer(True)
        #rig.set_stretch_axis('Y')
        rig.set_control_shape("cube")
        rig.set_stretch_type(2)
        rig.set_create_ik_buffer_joint(True)
        rig.set_pole_offset(size * 1)
        rig.set_pole_control_shape('square')

        # Create the rig
        rig.create()

        # Set parent groups and controls
        rig.set_setup_parent(rigparts)
        rig.set_control_parent("CNT_HIPS_C")
