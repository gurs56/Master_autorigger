from vtool.maya_lib import rigs
from vtool.maya_lib import space
import maya.cmds as cmds

def main():
    # Retrieve the group for rig parts
    rigparts = process.get_option("RigParts", group="Groups")
    
    # Loop through both sides
    for side in ['L', 'R']:
        # Retrieve the foot joint for the current side
        foot_options = process.get_option("Foot_%s" % side.lower(), group="Joint")
        
        if foot_options:  # Check if the list is not empty
            footJoint = foot_options[0]
            print "Foot joint for side %s: %s" % (side, footJoint)
        else:
            print "No foot options found for side %s or the list is empty." % side
            continue  # Skip to the next side if no options are found
        
        # Create and position locator for the foot
        locator_foot = cmds.spaceLocator(n='locator_foot_%s' % side)[0]
        
        # Use world space to match the joint's position
        position = cmds.xform(footJoint, query=True, translation=True, worldSpace=True)
        rotation = cmds.xform(footJoint, query=True, rotation=True, worldSpace=True)
        
        cmds.xform(locator_foot, translation=position, worldSpace=True)
        cmds.xform(locator_foot, rotation=rotation, worldSpace=True)
        
        # Parent to rig parts group
        cmds.parent(locator_foot, rigparts)

    return
