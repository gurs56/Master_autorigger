from vtool.maya_lib import rigs
from vtool.maya_lib import attr
import maya.cmds as cmds

def main():
    # List of sides
    arms = ['l', 'r']
    
    # Loop for Arms
    for arm in arms:
        # Find IK Arm joints for the current arm side
        IKArm = [
            i for i in process.get_option("IK_Arm", group="IKFK")
            if i.endswith('_%s' % arm)  # Ensure the name ends with the correct arm side
        ]

        # Debugging: Print the joints for the current arm side
        print("Found IK Arm Joints for arm '%s': %s" % (arm, IKArm))

        # Skip if no joints are found for the current arm side
        if not IKArm:
            cmds.warning("No IK Arm joints found for arm '%s'!" % arm)
            continue

        # Define pole vector setup (ensure the pole vector joints are correct)
        if len(IKArm) < 3:
            cmds.warning("Insufficient joints for IK setup on arm '%s'!" % arm)
            continue
        poleVac = [IKArm[0], "%s_poleAngle" % IKArm[1], IKArm[1]]

        # Create IK rig
        ArmRig = rigs.IkAppendageRig("IK_Arm", arm)
        ArmRig.set_joints(IKArm)
        ArmRig.set_control_offset_axis('z')
        ArmRig.set_control_size(6)
        ArmRig.set_create_stretchy(True)
        ArmRig.set_stretch_axis('x')
        #ArmRig.set_pole_angle_joints(poleVac)
        ArmRig.create()

        print("Successfully created IK Arm rig for arm '%s'." % arm)

    return
