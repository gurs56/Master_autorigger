from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util
import maya.cmds as cmds

def main():
    # List to store valid clavicle joint names
    ClavJoint = []
    sides = ['l', 'r']
    
    # Loop through the sides and filter for matching control names
    for side in sides:
        ClavJoint += [
            joint for joint in process.get_option("Arms", group="Joint")
            if "CNT_CLAVICLE_%s" % side == joint
        ]
    # Create the clavicle rig
    clav = rigs.SparseRig("clavicle")
    clav.set_joints(ClavJoint)
    clav.set_attach_joints(True)
    clav.set_control_to_pivot(True)
    clav.set_create_sub_control(False)
    clav.set_control_shape('yaw')
    clav.set_control_offset_axis('z')
    clav.set_control_size(4)
    clav.delete_setup()
    clav.create()
    clav.set_control_parent("CNT_SPINE_2_C")

    return
