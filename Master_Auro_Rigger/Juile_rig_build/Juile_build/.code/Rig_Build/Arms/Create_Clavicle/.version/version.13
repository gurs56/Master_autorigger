from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util
import maya.cmds as cmds

def main():
    # List to store valid clavicle joint names
    ClavJoint = []
    sides = ['l', 'r']
    
    # Loop through sides and retrieve clavicle joints
    for side in sides:
        for joint in process.get_option("Arms", group="Joint"):
            # Check for matching joint names and ensure they exist as nodes
            if "JNT_clavicle_%s" % side in joint:
                # Extract the short name of the joint (ignoring hierarchy)
                short_name = joint.split('|')[-1]
                if cmds.objExists(short_name) and cmds.nodeType(short_name) == 'joint':
                    ClavJoint.append(short_name)
    
    # Debugging: Print retrieved joints
    print("Retrieved Clavicle Joints:", ClavJoint)
    
    # Check if any clavicle joints are found
    if not ClavJoint:
        cmds.warning("No clavicle joints found!")
        return

    # Create the clavicle rig
    clav = rigs.SparseRig("clavicle")
    clav.set_joints(ClavJoint)
    clav.set_attach_joints(True)
    clav.set_control_to_pivot(True)
    clav.set_create_sub_control(False)
    clav.set_control_shape('yaw')
    clav.set_control_offset_axis('z')
    clav.set_control_size(4)
    clav.delete_setup()
    clav.create()
    clav.set_control_parent("CNT_SPINE_2_C")

    return
