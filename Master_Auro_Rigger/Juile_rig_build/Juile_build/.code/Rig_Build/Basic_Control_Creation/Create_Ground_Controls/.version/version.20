from vtool.maya_lib import rigs_util
from vtool.maya_lib import core
from vtool.maya_lib import rigs
import maya.cmds as cmds

def main():
    
    
    
    """
    # Create a control group
    control_group = "Control_Group"
    if not cmds.objExists(control_group):
        Con_grp = cmds.group(em=True, name=control_group)
    
    #Get Joint from input
    Get_Joint = process.get_option('Root', group = 'Joint')
    
    # Check if the joint exists before proceeding
    if not cmds.objExists(Get_Joint):
            raise Exception("Joint '{}' does not exist!".format(Get_Joint))
    """   
    #
    
    joints = cmds.joint()
    rig = rigs.GroundRig("World")
    rig.set_joints(joints)
    rig.set_attach_joints(False)
    
    # Set the control shape 
    rig.set_control_shape("outwardCirclePointer")
    rig.set_control_size(3)
    rig.set_control_color(22)
    rig.set_scalable(True)
    
    #rig.set_sub_control_shape("Root_sub")
    
    #rig.set_joints([Get_Joint])
    
    # Create the rig (will build the FK chain)
    rig.create()
    
    rig2 = rigs.GroundRig("Sub_World")
    rig2.set_joints(joints)
    rig2.set_attach_joints(False)
    
    
    rig2.set_control_shape("Circle")
    rig2.set_control_size(2.5)
    rig2.set_control_color(22)
    rig2.set_scalable(True)
    
    Parent = cmds.objExists("xform_CNT_WORLD_1")
    
    rig.create()
    rig2.create()
    
    cmds.Parent(Parent,"controls_Sub_World_1")
    
    """
    # Parent the rig under the control group
    fk_controls = rig.controls  # This holds the created FK controls
    cmds.parent(fk_controls[0], control_group)
    """
   

    return
