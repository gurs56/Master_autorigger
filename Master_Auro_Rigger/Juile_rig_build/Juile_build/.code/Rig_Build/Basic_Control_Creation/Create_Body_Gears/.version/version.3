from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util

def create_limb_control(control_name, joint_name, color):
    
    # Initialize the control
    gear = rigs_util.Control(control_name)
    gear.set_curve_type('gear')
    gear.set_control_size(2)
    gear.color(color)
    
