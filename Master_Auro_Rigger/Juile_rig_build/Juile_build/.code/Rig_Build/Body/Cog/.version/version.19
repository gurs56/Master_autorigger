from vtool.maya_lib import rigs
from vtool.maya_lib import rigs_util
import maya.cmds as cmds

def main():
    
    joints = process.get_option('Hip', group='Joint')
    
     # Check if joints were retrieved successfully
    if not joints:
        print("Warning! No joints found with the name 'hip' in the 'Joint' group.")
        return  # Exit if no joints found

    # Print retrieved joint for debugging
    print("Retrieved joint:", joints)
        
    cog = rigs.SparseRig("COG",side="C")
    cog.set_joints(joints)
    cog.set_create_sub_control(True)
    cog.set_sub_visibility(False)
    cog.set_control_shape("circleNub")
    cog.set_control_offset_axis('z')
    cog.set_control_size(10)
    cog.delete_setup()
    cog.create()
    return
